{
  "id": "cut_ededlerin_cemi",
  "title": "Cüt ədədlərin cəmi",
  "lesson": "Python əsasları: siyahı və for dövrü",
  "prompt": "cut_cem(ededler) funksiyasını yaz: siyahıdakı CÜT ədədlərin cəmini qaytarsın. Boş siyahı üçün 0.",
  "function": "cut_cem",
  "tests": [
    {"name": "sadə", "call": "cut_cem([1, 2, 3, 4])", "expected": "6"},
    {"name": "boş siyahı", "call": "cut_cem([])", "expected": "0"},
    {"name": "mənfi cüt", "call": "cut_cem([-2, -3, 5])", "expected": "-2"},
    {"name": "hamısı tək", "call": "cut_cem([1, 3, 5])", "expected": "0"},
    {"name": "sıfır", "call": "cut_cem([0, 0, 7])", "expected": "0"}
  ]
}
