# MasterAI — prod .env nümunəsi. Real dəyərlərlə doldurub `.env` kimi
# saxla (VPS-də, `.gitignore`-da — heç vaxt commit etmə).

# ===== MƏCBURİ =====
GROQ_API_KEY=                  # console.groq.com/keys — DilDostu/MasterNR1-dan AYRI açar tövsiyə olunur (limit paylaşılmasın)
JWT_SECRET=                    # ≥32 simvol: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_API_KEY=                 # ≥32 simvol, eyni üsulla — GET /admin/stats və n8n "Gündəlik Statistika" workflow-u üçün

# Canlı video dərs (Classroom, gün 2): cloud.livekit.io → layihə → Settings → Keys.
# Üçü də yoxdursa video söndürülmüş sayılır (POST /me/lessons/{id}/video → 503).
LIVEKIT_URL=                   # wss://<layihə>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ===== İSTƏYƏ BAĞLI =====
ANTHROPIC_API_KEY=             # Groq uğursuz olanda fallback (pipeline/providers.py, DEFAULT_ORDER)
GROQ_MODEL=openai/gpt-oss-120b        # llama-3.3-70b-versatile Groq-da dayandırılıb (bax pipeline/providers.py)
GROQ_WHISPER_MODEL=whisper-large-v3  # dərs səsi → mətn (Classroom, gün 3)
CLAUDE_MODEL=claude-sonnet-5
# Öz modelimiz (gün 16-17): QLoRA modeli vLLM ilə (OpenAI-uyğun API). Boşdursa işlənmir.
VLLM_BASE_URL=                 # məs. https://<tunel>.trycloudflare.com (ml/vllm_serve.ipynb çap edir)
VLLM_API_KEY=                  # vllm serve --api-key ilə eyni
VLLM_MODEL=masterai-mcq
VLLM_TIMEOUT=90                # san
VLLM_MAX_TOKENS=2048           # cavab bu həddə çatsa yarımçıq sayılır və növbəti provayderə keçilir
LLM_ORDER=groq,claude,ollama   # öz modeli birinci: vllm,groq,claude (düşsə Groq götürür)
OLLAMA_HOST=http://localhost:11434   # yalnız lokal inkişafda
OLLAMA_MODEL=qwen2.5:32b
AI_TEMPERATURE=0.5
LOG_LEVEL=INFO
SITE_URL=https://masterai.prdostu.com   # QR davamiyyət linki bu ünvanı açır (lokal sınaqda dəyişdir)
# Gün 15: çətinlik modeli (ml/README.md). Fayl yoxdursa proqnoz göstərilmir.
DIFFICULTY_MODEL_PATH=/opt/masterai/data/difficulty_model.json
ADMIN_WEBHOOK_URL=https://<N8N_HOST>/webhook/<WEBHOOK_PATH>   # uğursuz material → Telegram (artıq aktiv/production n8n workflow-u)
# Gündəlik backup-ın serverdən kənar nüsxəsi (deploy/backup_data.py). @BotFather-dan
# bot yarat, bota bir mesaj yaz, chat_id-ni https://api.telegram.org/bot<TOKEN>/getUpdates-dən götür.
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=
# Uğursuz material bildirişi üçün ayrı bot (boşdursa yuxarıdakı backup botu işlənir)
ADMIN_TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_CHAT_ID=

# ===== DB yolları (data/ qovluğu — kod qovluğundan AYRI, bax DEPLOY.md) =====
USERS_DB_PATH=/opt/masterai/data/users.db
CHATS_DB_PATH=/opt/masterai/data/chats.db
MESSAGES_DB_PATH=/opt/masterai/data/messages.db
MATERIALS_DB_PATH=/opt/masterai/data/materials.db
QUESTIONS_DB_PATH=/opt/masterai/data/questions.db
QUIZ_SESSIONS_DB_PATH=/opt/masterai/data/quiz_sessions.db
QUIZ_ATTEMPTS_DB_PATH=/opt/masterai/data/quiz_attempts.db
FRIENDSHIPS_DB_PATH=/opt/masterai/data/friendships.db
QUESTION_SETS_DB_PATH=/opt/masterai/data/question_sets.db          # canlı sinif sessiyası (Faza 1)
HOMEWORK_DB_PATH=/opt/masterai/data/homework.db                    # ev təkrarı rejimi (Faza 2)
LESSONS_DB_PATH=/opt/masterai/data/lessons.db                      # dərs cədvəli və davamiyyət (Classroom)
LIVE_SESSIONS_DB_PATH=/opt/masterai/data/live_sessions.db
BADGES_DB_PATH=/opt/masterai/data/badges.db
CHAT_JOIN_REQUESTS_DB_PATH=/opt/masterai/data/chat_join_requests.db
SUMMARIES_DB_PATH=/opt/masterai/data/summaries.db
MATERIAL_UPLOAD_DIR=/opt/masterai/data/uploads

# LangSmith izləmə (gün 10, könüllü): hər LLM çağırışı və agent addımı
# smith.langchain.com-da görünür. Açar boşdursa heç nə göndərilmir.
# Diqqət: izdə dərs mətni və tələbə sualları olur - yalnız öz hesabınız.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=masterai
